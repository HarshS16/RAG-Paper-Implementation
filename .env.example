# Groq API key, used for both generation and LLM-as-judge evaluation.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional. Takes precedence over GROQ_API_KEY when set, so a run halted by
# an exhausted daily quota can be resumed on a fresh key without code changes.
GROQ_NEW_API_KEY=
